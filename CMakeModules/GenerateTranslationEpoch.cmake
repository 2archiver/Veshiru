# Writes ${OUTPUT} with Vulkan::Nvn::Disk::TranslationEpoch(): the SHA-256 of every input that
# decides the SPIR-V the NVN pipeline disk cache stores. The cache file of a build is named by this
# epoch (plus the device, driver and translation switches), so a build that did not change the
# translation reuses the cache of the one before it, and a build that did gets a fresh file.
#
# Run at every build (a custom target, see video_core/CMakeLists.txt) so an edit of any listed
# file changes the epoch without a reconfigure. The output is only rewritten when the epoch
# changed, so an unchanged epoch recompiles nothing.
#
# Usage: cmake -DSOURCE_DIR=<repo root> -DOUTPUT=<file> -P GenerateTranslationEpoch.cmake
#
# THE LIST BELOW IS THE CONTRACT. A file that influences translated SPIR-V and is missing from it
# would serve stale SPIR-V after an edit; add it here (and keep the manual FORMAT_VERSION bump in
# nvn_pipeline_disk.h for changes that alter the record format itself). Settings and environment
# switches the translation reads are not files: see TranslationSwitches in nvn_pipeline_state.h.

if(NOT DEFINED SOURCE_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "GenerateTranslationEpoch: SOURCE_DIR and OUTPUT are required")
endif()

# Directories hashed whole: the recompiler (frontend lowering incl. the Ampere decoder, IR passes,
# SPIR-V backend) and the NVN program lowering / environment / descriptor layout.
set(EPOCH_DIRECTORIES
    src/shader_recompiler
    src/video_core/nvn/shader
)

# Files under a hashed directory that never take part in the NVN Vulkan translation: the OpenGL
# text backends (GLSL, GLASM) are separate emitters nothing in the SPIR-V path includes, so an
# edit there (upstream merges touch them often) must not start every user's cache over.
set(EPOCH_EXCLUDED_REGEXES
    "^src/shader_recompiler/backend/glsl/"
    "^src/shader_recompiler/backend/glasm/"
)

# Single files: the pipeline translation and the code that builds the runtime info and record
# keys the stored SPIR-V depends on, the guest state layouts those read, and the Vulkan profile
# helpers feeding the translation.
set(EPOCH_FILES
    src/video_core/nvn/state_layouts.h
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_cache.cpp
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_cache.h
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_cache_disk.cpp
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_disk.cpp
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_disk.h
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_impl.h
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_state.cpp
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_state.h
    src/video_core/renderer_vulkan/nvn/nvn_pipeline_vk.cpp
    src/video_core/vulkan_common/cooperative_matrix.h
)

set(epoch_files ${EPOCH_FILES})
foreach(dir IN LISTS EPOCH_DIRECTORIES)
    file(GLOB_RECURSE found LIST_DIRECTORIES false RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/${dir}/*")
    list(LENGTH found found_count)
    if(found_count EQUAL 0)
        message(FATAL_ERROR "GenerateTranslationEpoch: no files under ${SOURCE_DIR}/${dir}; "
                            "update EPOCH_DIRECTORIES")
    endif()
    foreach(excluded IN LISTS EPOCH_EXCLUDED_REGEXES)
        list(FILTER found EXCLUDE REGEX "${excluded}")
    endforeach()
    list(APPEND epoch_files ${found})
endforeach()
list(REMOVE_DUPLICATES epoch_files)
list(SORT epoch_files)

set(manifest "")
foreach(rel IN LISTS epoch_files)
    if(NOT EXISTS "${SOURCE_DIR}/${rel}")
        message(FATAL_ERROR "GenerateTranslationEpoch: ${rel} is listed but does not exist")
    endif()
    file(SHA256 "${SOURCE_DIR}/${rel}" file_hash)
    string(APPEND manifest "${rel} ${file_hash}\n")
endforeach()

# The sirit pin (version, archive hash, patch list) selects the SPIR-V emitter library.
file(READ "${SOURCE_DIR}/cpmfile.json" cpm_json)
string(JSON sirit_pin GET "${cpm_json}" "sirit")
string(APPEND manifest "sirit ${sirit_pin}\n")

string(SHA256 epoch "${manifest}")
list(LENGTH epoch_files epoch_file_count)

set(content "// Generated by CMakeModules/GenerateTranslationEpoch.cmake at every build. Do not edit.
// ${epoch_file_count} translation inputs.

#include <string_view>

#include \"video_core/renderer_vulkan/nvn/nvn_pipeline_disk.h\"

namespace Vulkan::Nvn::Disk {

std::string_view TranslationEpoch() {
    return \"${epoch}\";
}

} // namespace Vulkan::Nvn::Disk
")

set(existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_dir}")
    file(WRITE "${OUTPUT}" "${content}")
endif()

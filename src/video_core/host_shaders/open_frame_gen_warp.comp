#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D PrevFrame;
layout(binding = 1) uniform sampler2D CurrFrame;
layout(binding = 2) uniform sampler2D FlowMaskTex;
layout(binding = 3) uniform writeonly image2D OutGeneratedFrame;

layout(push_constant) uniform PushConstants {
    vec2 inv_render_size;
    vec2 render_size;
    float blend_factor;
    float sharpness;
} pc;

vec3 warpFetch(sampler2D tex, vec2 uv) {
    return textureLod(tex, clamp(uv, vec2(0.0), vec2(1.0)), 0.0).rgb;
}

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.render_size.x) || px.y >= int(pc.render_size.y)) {
        return;
    }

    const vec2 uv = (vec2(px) + 0.5) * pc.inv_render_size;
    const vec3 fm = textureLod(FlowMaskTex, uv, 0.0).xyz;
    const vec2 flow_uv = fm.xy;
    const float mask = clamp(fm.z, 0.0, 1.0);

    const vec2 uv0 = uv + flow_uv * pc.blend_factor;
    const vec2 uv1 = uv + flow_uv * (pc.blend_factor - 1.0);

    const vec4 s0 = textureLod(PrevFrame, clamp(uv0, vec2(0.0), vec2(1.0)), 0.0);
    const vec4 s1 = textureLod(CurrFrame, clamp(uv1, vec2(0.0), vec2(1.0)), 0.0);
    vec3 color = mix(s1.rgb, s0.rgb, mask);

    // Local 5-tap Contrast Adaptive Sharpening clamped strictly to the warped local [min, max]
    // neighborhood so edges stay crisp without ringing or clipping HDR/SDR values.
    if (pc.sharpness > 0.0) {
        const vec2 dx = vec2(pc.inv_render_size.x, 0.0);
        const vec2 dy = vec2(0.0, pc.inv_render_size.y);
        const vec3 n = mix(warpFetch(CurrFrame, uv1 - dy), warpFetch(PrevFrame, uv0 - dy), mask);
        const vec3 s = mix(warpFetch(CurrFrame, uv1 + dy), warpFetch(PrevFrame, uv0 + dy), mask);
        const vec3 e = mix(warpFetch(CurrFrame, uv1 + dx), warpFetch(PrevFrame, uv0 + dx), mask);
        const vec3 w = mix(warpFetch(CurrFrame, uv1 - dx), warpFetch(PrevFrame, uv0 - dx), mask);
        const vec3 mn = min(min(min(n, s), min(e, w)), color);
        const vec3 mx = max(max(max(n, s), max(e, w)), color);
        const vec3 avg = 0.25 * (n + s + e + w);
        color = clamp(color + (color - avg) * pc.sharpness, mn, mx);
    }

    const float alpha = mix(s1.a, s0.a, mask);
    imageStore(OutGeneratedFrame, px, vec4(color, alpha));
}
